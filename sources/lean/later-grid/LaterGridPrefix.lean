def originalPrefix : List Comparison :=
  originalComparisons 1 sourceRows001 ++ originalComparisons 2 sourceRows002

def movedPrefix : List Comparison :=
  sourceComparisons 1 sourceRows001 ++ sourceComparisons 2 sourceRows002

theorem original_count : originalPrefix.length = 402 := rfl

theorem moved_count : movedPrefix.length = 402 := rfl

theorem original_reversed_sites :
    (originalPrefix.filter Comparison.reversed).map Comparison.site = [106, 114, 184, 242, 378] :=
  rfl

theorem moved_all_forward : movedPrefix.all (fun row ↦ !row.reversed) = true := rfl

/-- All 402 original comparisons have strict certified directions. The five
listed reversed comparisons are the exact original failures. -/
theorem original_classification : List.Forall Comparison.Check originalPrefix :=
  List.forall_append.mpr ⟨original_checks_001, original_checks_002⟩

/-- With the five substitutions, every one of the 402 shared comparisons passes. -/
theorem moved_all_checks : List.Forall Comparison.Check movedPrefix :=
  List.forall_append.mpr ⟨moved_checks_001, moved_checks_002⟩

