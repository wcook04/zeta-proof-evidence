/-- The original grid passes its own-height bound. Five endpoints come directly
from the focused checks. The shared proofs discharge every unchanged endpoint. -/
theorem pinned_own_checked (row : Comparison)
    (h : row ∈ (pinnedRows.map (fun p ↦ originalOwnComparisons p.1 p.2)).flatten) :
    row.Check := by
  obtain ⟨block, hb, hr⟩ := List.mem_flatten.mp h
  obtain ⟨part, hp, rfl⟩ := List.mem_map.mp hb
  have hReady := List.forall_iff_forall_mem.mp pinned_originals_ready part hp
  have hShared (m : Comparison) (hm : m ∈ sourceComparisons part.1 part.2) : m.Check :=
    pinned_shared_checked m (List.mem_flatten.mpr
      ⟨_, List.mem_map.mpr ⟨part, hp, rfl⟩, hm⟩)
  exact originalOwn_of_sourceBatch hReady hShared row hr

